{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GW2 WvW Thief release manifest",
  "type": "object",
  "required": ["schema_version", "game_build_id", "mode", "created_from", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "game_build_id": {"type": "integer", "minimum": 1},
    "mode": {"const": "wvw"},
    "created_from": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "sha256"],
        "properties": {
          "filename": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
