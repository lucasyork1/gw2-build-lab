{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed WvW Thief build analysis",
  "type": "object",
  "required": [
    "schema_version",
    "build_id",
    "ruleset_id",
    "dimensions",
    "strengths",
    "weaknesses",
    "improvements"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "build_id": {"type": "string", "minLength": 1},
    "ruleset_id": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "object",
      "required": [
        "burst_damage",
        "sustained_damage",
        "survival_recovery",
        "condition_cleanse",
        "control_interrupt",
        "mobility_disengage",
        "stealth_reset",
        "operation_difficulty"
      ],
      "properties": {
        "burst_damage": {"$ref": "#/$defs/dimension_result"},
        "sustained_damage": {"$ref": "#/$defs/dimension_result"},
        "survival_recovery": {"$ref": "#/$defs/dimension_result"},
        "condition_cleanse": {"$ref": "#/$defs/dimension_result"},
        "control_interrupt": {"$ref": "#/$defs/dimension_result"},
        "mobility_disengage": {"$ref": "#/$defs/dimension_result"},
        "stealth_reset": {"$ref": "#/$defs/dimension_result"},
        "operation_difficulty": {"$ref": "#/$defs/dimension_result"}
      },
      "additionalProperties": false
    },
    "strengths": {
      "type": "array",
      "items": {"$ref": "#/$defs/conclusion"}
    },
    "weaknesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/conclusion"}
    },
    "improvements": {
      "type": "array",
      "items": {"$ref": "#/$defs/improvement"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["component_kind", "component_id", "field"],
      "properties": {
        "component_kind": {"type": "string", "minLength": 1},
        "component_id": {"type": ["integer", "string"]},
        "field": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "dimension_result": {
      "type": "object",
      "required": [
        "band",
        "label",
        "confidence",
        "confidence_reasons",
        "evidence"
      ],
      "properties": {
        "band": {"type": "integer", "minimum": 1, "maximum": 5},
        "label": {
          "enum": ["very_low", "low", "medium", "high", "very_high"]
        },
        "confidence": {"enum": ["low", "medium", "high"]},
        "confidence_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "additionalProperties": false
    },
    "conclusion": {
      "type": "object",
      "required": ["rule_id", "claim", "evidence"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "required": ["component_kind", "component_id"],
      "properties": {
        "component_kind": {"type": "string", "minLength": 1},
        "component_id": {"type": ["integer", "string"]},
        "field": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "improvement": {
      "type": "object",
      "required": [
        "improvement_id",
        "replace",
        "with",
        "benefit",
        "cost",
        "applies_when",
        "evidence",
        "derived_build"
      ],
      "properties": {
        "improvement_id": {"type": "string", "minLength": 1},
        "replace": {"$ref": "#/$defs/selector"},
        "with": {"$ref": "#/$defs/selector"},
        "benefit": {"type": "string", "minLength": 1},
        "cost": {"type": "string", "minLength": 1},
        "applies_when": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/selector"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "derived_build": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
