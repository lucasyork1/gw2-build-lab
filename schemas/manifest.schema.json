{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GW2 raw snapshot manifest",
  "type": "object",
  "required": ["schema_version", "game_build_id", "fetched_at", "api_base_url", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "game_build_id": {"type": "integer", "minimum": 1},
    "fetched_at": {"type": "string", "format": "date-time"},
    "api_base_url": {"const": "https://api.guildwars2.com"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
